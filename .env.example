# Copy to .env and fill in. Everything here is bundled into the client at build
# time — VITE_ variables are PUBLIC. Never put a private key in this file.
#
# Server-only secrets (the service role key, the Gemini key) belong in Supabase
# secrets, not here:
#   supabase secrets set SECRET_SERVICE_ROLE_KEY=... --project-ref <ref>
#   supabase secrets set GEMINI_API_KEY=...          --project-ref <ref>

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The anon/publishable key. Safe to expose — every table is protected by RLS.
VITE_SUPABASE_ANON_KEY=
